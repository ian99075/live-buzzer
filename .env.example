# 複製為 .env，填入自己的教師帳號密碼。沒有預設管理密碼。
TEACHER_USERNAME=
TEACHER_PASSWORD=
HOST=127.0.0.1
PORT=3000
# 教室使用時改為主機區域網路網址，HOST 改為 0.0.0.0。
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
# 題目與答案佔位符所在的原生 Google Sheet（題目 q 鍵在題目格備註）。
GOOGLE_SHEET_ID=1X7YNIcyvPMsbUnTuBdJ5lwmkZmIHj2-wO-S7CdpEwo0
GOOGLE_SHEET_NAME=學習單
# 服務帳號 JSON 路徑；不要把憑證提交到版本控制。
GOOGLE_APPLICATION_CREDENTIALS=
