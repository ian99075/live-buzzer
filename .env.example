# 複製為 .env，填入自己的教師帳號密碼。沒有預設管理密碼。
TEACHER_USERNAME=
TEACHER_PASSWORD=
HOST=127.0.0.1
PORT=3000
# 教室使用時改為主機區域網路網址，HOST 改為 0.0.0.0。
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
# 請填轉換後的原生 Google Sheet ID，原始 XLSX 不可直接使用。
GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=工作表1
# 服務帳號 JSON 路徑；不要把憑證提交到版本控制。
GOOGLE_APPLICATION_CREDENTIALS=
